#!name=小火箭-广告隐私与视频直连
#!desc=温和广告与追踪拦截，并将常见国内视频平台及 CDN 设为直连；不启用 HTTPS 解密。

[Rule]
# X（Twitter）及图片、视频 CDN 强制走代理，避免被 GEOIP,CN 误判为直连
DOMAIN-SUFFIX,x.com,PROXY
DOMAIN-SUFFIX,twitter.com,PROXY
DOMAIN-SUFFIX,twimg.com,PROXY
DOMAIN-SUFFIX,t.co,PROXY
DOMAIN-SUFFIX,tweetdeck.com,PROXY

# 抖音国内版完整域名规则集（远程规则，随上游更新）
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/DouYin/DouYin.list,DIRECT

# 国内视频平台及视频 CDN 直连
# 哔哩哔哩
DOMAIN-SUFFIX,bilibili.com,DIRECT
DOMAIN-SUFFIX,bilivideo.com,DIRECT
DOMAIN-SUFFIX,bilivideo.cn,DIRECT
DOMAIN-SUFFIX,hdslb.com,DIRECT
DOMAIN-SUFFIX,biliapi.net,DIRECT

# 爱奇艺
DOMAIN-SUFFIX,iqiyi.com,DIRECT
DOMAIN-SUFFIX,qiyi.com,DIRECT
DOMAIN-SUFFIX,qy.net,DIRECT
DOMAIN-SUFFIX,qiyipic.com,DIRECT

# 腾讯视频
DOMAIN-SUFFIX,v.qq.com,DIRECT
DOMAIN-SUFFIX,video.qq.com,DIRECT
DOMAIN-SUFFIX,gtimg.com,DIRECT

# 优酷
DOMAIN-SUFFIX,youku.com,DIRECT
DOMAIN-SUFFIX,ykimg.com,DIRECT

# 芒果 TV
DOMAIN-SUFFIX,mgtv.com,DIRECT
DOMAIN-SUFFIX,hunantv.com,DIRECT

# 抖音及字节系视频 CDN
DOMAIN-SUFFIX,douyin.com,DIRECT
DOMAIN-SUFFIX,douyinvod.com,DIRECT
DOMAIN-SUFFIX,bytecdn.cn,DIRECT
DOMAIN-SUFFIX,byteimg.com,DIRECT

# YouTube App / 网站走代理（仅优化线路，不保证去除首页广告）
DOMAIN-SUFFIX,youtube.com,PROXY
DOMAIN-SUFFIX,youtu.be,PROXY
DOMAIN-SUFFIX,youtube-nocookie.com,PROXY
DOMAIN-SUFFIX,googlevideo.com,PROXY
DOMAIN-SUFFIX,ytimg.com,PROXY
DOMAIN-SUFFIX,yt3.ggpht.com,PROXY
DOMAIN-SUFFIX,youtubei.googleapis.com,PROXY
DOMAIN-SUFFIX,youtube.googleapis.com,PROXY

# 常见广告投放与统计
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT
DOMAIN-SUFFIX,googleadservices.com,REJECT
DOMAIN-SUFFIX,adservice.google.com,REJECT
DOMAIN-SUFFIX,adnxs.com,REJECT
DOMAIN-SUFFIX,adsrvr.org,REJECT
DOMAIN-SUFFIX,adform.net,REJECT
DOMAIN-SUFFIX,taboola.com,REJECT
DOMAIN-SUFFIX,outbrain.com,REJECT
DOMAIN-SUFFIX,criteo.com,REJECT
DOMAIN-SUFFIX,scorecardresearch.com,REJECT

# 常见分析与追踪
DOMAIN-SUFFIX,google-analytics.com,REJECT
DOMAIN-SUFFIX,googletagmanager.com,REJECT
DOMAIN-SUFFIX,app-measurement.com,REJECT
DOMAIN-SUFFIX,branch.io,REJECT
DOMAIN-SUFFIX,adjust.com,REJECT
DOMAIN-SUFFIX,appsflyer.com,REJECT
DOMAIN-SUFFIX,facebook.net,REJECT
DOMAIN-SUFFIX,connect.facebook.net,REJECT
DOMAIN-SUFFIX,analytics.twitter.com,REJECT
DOMAIN-SUFFIX,bat.bing.com,REJECT
DOMAIN-SUFFIX,hotjar.com,REJECT
DOMAIN-SUFFIX,segment.io,REJECT
DOMAIN-SUFFIX,mixpanel.com,REJECT
DOMAIN-SUFFIX,amplitude.com,REJECT

# 常见移动广告与统计域名
DOMAIN-SUFFIX,umeng.com,REJECT
DOMAIN-SUFFIX,umengcloud.com,REJECT
DOMAIN-SUFFIX,ads.mopub.com,REJECT
DOMAIN-SUFFIX,admob.com,REJECT

# 说明：这是温和的域名级拦截清单。若某个 App 登录、支付、推送或内容加载异常，
# 可先停用本模块验证；不要为此开启全局 HTTPS 解密。
